# Leave VITE_API_URL EMPTY in development.
#
# An empty value makes the app issue same-origin requests (/api/..., /auth/...)
# which the Vite dev server proxies to Flask (see vite.config.js). That keeps the
# Flask session cookie first-party, so login survives a page refresh whether you
# open the app on http://localhost:3000 or http://127.0.0.1:3000.
#
# Set it to an absolute URL only when the frontend is deployed separately from
# the API and you have configured CORS + SameSite=None; Secure cookies for it.
VITE_API_URL=

# Absolute origin of the Flask backend. Used ONLY to start the Google OAuth
# round-trip, which has to leave the SPA and come back from Google.
VITE_BACKEND_ORIGIN=http://localhost:5000
